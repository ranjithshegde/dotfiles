#!/bin/sh

declare options=("random
search
quit")

choice=$(echo -e "${options[@]}" | dmenu -i -p 'Manuals: ')

case "$choice" in
	quit)
		echo "Program terminate." && exit 1
		;;
	random)
		find /usr/share/man/man1 -type f | shuf | awk -F '/' '/1/ {print $6}' | sed 's/.gz//g' | head -1 | dmenu -i -p 'Random Manual:' | xargs st -e man
		;;
	search)
		man -k . | awk '{print $1}' | dmenu -i -c -l 20 -p 'Search Manuals:' | xargs st -e man
		;;
esac
