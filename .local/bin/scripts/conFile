#!/bin/sh

declare options=("rType
Zr 
zenv
initV
initL
dwm
st
qute
")

choice=$(echo -e "${options[@]}" | dmenu -i -p 'pick rc file')

case "$choice" in
  rType)
    st -e nvim "/home/ranjith/Nextcloud/Backup/ranger/rifle.conf"
    ;;
    zenv)
    st -e nvim "/home/ranjith/Nextcloud/Backup/zsh/.zshenv"
    ;;
  initV)
    st -e nvim /home/ranjith/Nextcloud/Backup/neovim/init.vim
    ;;
  initL)
    st -e nvim /home/ranjith/Nextcloud/Backup/neovim/init.lua
    ;;
  dwm)
    st -e nvim /home/ranjith/Nextcloud/Repos/dwm/config.h
    ;;
  st)
    st -e nvim /home/ranjith/Nextcloud/Repos/st/config.h
    ;;
  qute)
    st -e nvim /home/ranjith/Nextcloud/Backup/qutebrowser/config.py
    ;;
  Zr)
    st -e nvim "/home/ranjith/Nextcloud/Backup/zsh/.zshrc"
    ;;
esac
