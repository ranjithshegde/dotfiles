#!/bin/zsh

declare -a d_opts
d_opts=("Beast
Perf
Bal
Prac
Min
Ultra")

choice=$(echo -e $d_opts[@] | dmenu -c -l 7 -i -p 'Power profile: ' -fn $dmenu_font -nb $col_gray1 -nf $col_gray3 -sb $col_pink -sf $col_gray4)

case "$choice" in
	Ultra)
		sdo ultra
		;;
	Min)
		sdo minimum
		;;
	Prac)
		sdo practical
		;;
	Bal)
		sdo balance
		;;
	Perf)
		sdo performance
		;;
	Beast)
		sdo beast
		;;
esac
