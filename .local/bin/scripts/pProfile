#!/bin/sh

ultra(){
    echo powersupersave >/sys/module/pcie_aspm/parameters/policy &
    echo 'auto' >/sys/bus/usb/devices/1-8/power/control &
    x86_energy_perf_policy power
    asusctl profile -P Quiet &
    xrandr --rate 60
    light -S 15
    rfkill block wlan
    echo "N-key watchced, aggressive powersaving"
}

minimum() {
    echo powersupersave >/sys/module/pcie_aspm/parameters/policy &
    echo 'on' >/sys/bus/usb/devices/1-8/power/control &
    xrandr --rate 144
    x86_energy_perf_policy power &
    asusctl profile -P Quiet &
    rfkill unblock wlan
    echo "Powersave mode with unmonitored N-key"
}

practical(){
    echo powersave >/sys/module/pcie_aspm/parameters/policy &
    echo 'on' >/sys/bus/usb/devices/1-8/power/control &
    x86_energy_perf_policy balance-power &
    asusctl profile -P Balanced &
    echo "Conservative but sensible savings"
}

balance(){
    echo default >/sys/module/pcie_aspm/parameters/policy
    x86_energy_perf_policy balance-performance
    asusctl profile -P Balanced
    echo "all performance governers turned to on-demand"
}

performance(){
    echo performance >/sys/module/pcie_aspm/parameters/policy
    x86_energy_perf_policy balance-performance
    asusctl profile -P Performance
    echo "all performance governers turned to high-performance"
}

beast(){
    echo performance >/sys/module/pcie_aspm/parameters/policy
    x86_energy_perf_policy performance
    asusctl profile -P Performance
    # asusctl profile -P Performance -f boost -t true
    echo "boost on, cpu & pci-e ports on performance mode"
}


declare options=("Beast
Perf
Bal
Prac
Min
Ultra")

choice=$(echo -e "${options[@]}" | dmenu -i -p 'Power profile: ')

case "$choice" in
	Ultra)
        sudo -A sh -c "$(declare -f ultra); ultra"
		;;
	Min)
        sudo -A sh -c "$(declare -f minimum); minimum"
		;;
	Prac)
        sudo -A sh -c "$(declare -f practical); practical"
		;;
	Bal)
        sudo -A sh -c "$(declare -f balance); balance"
		;;
	Perf)
        sudo -A sh -c "$(declare -f performance); performance"
		;;
	Beast)
        sudo -A sh -c "$(declare -f beast); beast"
		;;
esac
