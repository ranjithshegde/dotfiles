#!/bin/sh
intern=eDP-1
extern=HDMI-1-0

if xrandr | grep "$extern disconnected"; then
	xrandr --output "$extern" --off --output "$intern" --mode 1920x1080 --rate 144 &
	nitrogen --force-setter=xinerama --restore
else
	xrandr --output "$intern" --primary --mode 1920x1080 --rate 144 --output "$extern" --right-of "$intern" --mode 1920x1080 --rate 60 &
	nitrogen --force-setter=xinerama --restore
fi
