#!/bin/sh
intern=eDP-1
extern=HDMI-1-0
usc=DP-1-0

declare intern-prop="--mode 1920x1080 --rate 144 --dpi 96"
declare extern-prop="--mode 1920x1080 --rate 60 --dpi 96"

if xrandr | grep "$extern disconnected" || xrandr | grep "$usc disconnected"; then
    xrandr --output "$extern" --off --output "$intern" ${intern-prop} &
else
    declare options=(
    "Left
    Right")

    choice=$(echo -e "${options[@]}" | dmenu -i -c -l 2 -p 'Choose HDMI screen position: ')
    case "$choice" in
        Left) position='--left-of'
            ;;
        Right) position='--right-of'
            ;;
        *) position='--right-of'
            ;;
    esac

    if xrandr | grep "$usc connected"; then
        xrandr --output "$intern" ${intern-prop} --output "$usc" "$position" "$intern" ${extern-prop} &
    else
        xrandr --output "$intern" ${intern-prop} --output "$extern" "$position" "$intern" ${extern-prop} &
    fi
fi

launch-polybar
nitrogen --force-setter=xinerama --restore
