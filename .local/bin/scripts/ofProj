#!/bin/sh

DR=$(echo -e '' | dmenu -c -p "Enter directory: ")
AD=$(echo -e '' | dmenu -c -p "Addons, comma separated: ")
PN=$(echo -e '' | dmenu -c -p "Project name: ")

mkdir -p $PG_OF_PATH/${DR} && cd $PG_OF_PATH/${DR}

projectGenerator -a"${AD}" ${PN} && cd ${PN}

git init

compiledb -n make

ctags -R -c++-kinds=+p --fields=+iaS --extras+q .

clang-format -style=webkit -dump-config >.clang-format

{
	echo .cache/
	echo .ccls-cache/
    echo .clang-format
	echo tags
	echo compile_commands.json
    echo *.qbs
	echo obj/
    echo bin/*
    echo !bin/data
    echo bin/data/*
    echo !bin/data/*.vert
    echo !bin/data/*.frag
} >>.gitignore

st -e nvim src/ofApp.h
