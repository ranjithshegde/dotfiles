# theme = Rose Pine Moon
theme = Catppuccin Mocha
background-opacity = 0.85
window-decoration = false
gtk-titlebar = false
font-size = 13
font-synthetic-style = true
confirm-close-surface = false

keybind = shift+control+h=new_split:left
keybind = shift+control+j=new_split:down
keybind = shift+control+k=new_split:up
keybind = shift+control+l=new_split:right

keybind = alt+control+h=goto_split:left
keybind = alt+control+j=goto_split:down
keybind = alt+control+k=goto_split:up
keybind = alt+control+l=goto_split:right
